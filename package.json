{
  "name": "webxr-interactions-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "demos/*"
  ],
  "scripts": {
    "build": "npm run build -w @realitycollective/webxr-interactions -w @realitycollective/threejs-interactions -w @realitycollective/iwsdk-interactions -w @realitycollective/xrblocks-interactions",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:playground": "npm run dev -w playground-demo"
  },
  "devDependencies": {
    "@realitycollective/webxr-input": "file:../WebXR-Input",
    "@types/node": "^22.20.1",
    "@types/three": "^0.180.0",
    "three": "npm:super-three@0.181.0",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  }
}
