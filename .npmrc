# xrblocks@0.19 declares peer three@^0.184 while IWSDK mandates the
# super-three@0.181 fork (aliased as `three` workspace-wide, enforced via
# the root package.json `overrides`). Vite resolves a single `three` for
# any given bundle, so the pairing works in practice; npm's peer check
# cannot express it. Tracked in the xrblocks-uiextensions README as part
# of that adapter's EXPERIMENTAL status.
legacy-peer-deps=true
