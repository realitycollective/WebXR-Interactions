# `three` is aliased workspace-wide to Meta's super-three fork at 0.185.0
# (root package.json `overrides`), the version every WebXR repository uses.
# @iwsdk/core 1.0.x pins super-three@0.181.0, and xrblocks 0.21 declares a peer
# of three@^0.184 and logs an error below r182. No single version satisfies
# both declarations, so the override gives IWSDK and XR Blocks one shared copy
# of r185. npm's peer check compares declarations and cannot express that, so
# legacy resolution keeps `npm ci` and `verify:pack` working. Tracked in the
# xrblocks-interactions README as part of that adapter's EXPERIMENTAL status.
legacy-peer-deps=true
