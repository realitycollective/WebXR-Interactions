<!--
  One template for every station panel.

  The body text is NOT baked in here - main.ts sets it per station through
  `panel.getElementById("body").setProperties({ text })` when the panel is
  ready, so nine stations share this single markup file instead of nine
  near-identical copies.

  The `uix-*` ids are the window chrome contract the UI Extensions core binds
  to: titlebar, title, and the pin/dock/minimise/close buttons.
-->
<style>
  .uix-window {
    display: flex;
    flex-direction: column;
    width: 260;
    background-color: #101a26;
    background-opacity: 0.92;
    border-color: #2e4a66;
    border-width: 0.75;
    border-radius: 12.5;
  }
  .uix-titlebar {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 8;
    background-color: #1b2c40;
    border-top-left-radius: 12.5;
    border-top-right-radius: 12.5;
    cursor: pointer;
  }
  .uix-titlebar:hover { background-color: #24405e; }
  .uix-title { flex-shrink: 1; font-size: 12; font-weight: bold; color: #dce9f7; }
  .uix-titlebar-buttons { display: flex; flex-direction: row; flex-shrink: 0; }
  .uix-titlebar-button {
    width: 30;
    height: 20;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin-left: 4;
    font-size: 9;
    color: #9fb8d4;
    background-color: #223850;
    border-radius: 6;
    cursor: pointer;
  }
  .uix-titlebar-button:hover { background-color: #33547a; color: #ffffff; }
  .uix-content { display: flex; flex-direction: column; width: 100%; padding: 10; }

  .body-text { font-size: 10; color: #c4d6ea; }
  .hint {
    margin-top: 8;
    font-size: 9;
    color: #6fb4ff;
  }
</style>
<div id="uix-window" class="uix-window">
  <div id="uix-titlebar" class="uix-titlebar">
    <span id="uix-title" class="uix-title">.</span>
    <div class="uix-titlebar-buttons">
      <div id="uix-dock" class="uix-titlebar-button">DOCK</div>
      <div id="uix-minimize" class="uix-titlebar-button">MIN</div>
      <div id="uix-close" class="uix-titlebar-button">X</div>
    </div>
  </div>
  <div id="uix-content" class="uix-content">
    <span id="body" class="body-text">.</span>
    <span id="hint" class="hint">.</span>
  </div>
</div>
